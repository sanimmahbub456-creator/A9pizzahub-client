# Public URL of this Next.js app (no trailing slash). On Vercel: https://your-app.vercel.app
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-long-random-string

# Same database as the Express server
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net
DB_NAME=pizzahub

# Google OAuth (redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google)
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxx

# Express API base URL (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:5000

# ImgBB key - server-only, used by /api/upload (never exposed to the browser)
IMGBB_API_KEY=xxx
